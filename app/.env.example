# Express API base URL. Leave unset locally to use the dev proxy (setupProxy.js);
# in production set to your deployed API, e.g. https://your-api.onrender.com/api
REACT_APP_API_URL=http://localhost:5000/api

# FastAPI ML service base URL. Leave unset locally to use the dev proxy; in
# production set to your deployed ML host, e.g. https://your-ml.onrender.com
# (no /api suffix -- request paths already include it, e.g. ${ML_URL}/api/bias/...)
REACT_APP_ML_URL=http://localhost:8000

FINNHUB_API_KEY=your-finnhub-api-key

# Firebase web config (from Firebase console > Project settings > Your apps)
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id
REACT_APP_FIREBASE_MEASUREMENT_ID=your-measurement-id
