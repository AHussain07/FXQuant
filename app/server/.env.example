# --- Express API configuration ---

# MongoDB connection string (MongoDB Atlas in production, local mongod in dev)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Port the API listens on. Managed hosts (Render/Railway) inject this automatically;
# defaults to 5000 locally if unset.
PORT=5000

# Comma-separated list of allowed browser origins for CORS.
# Local dev default is http://localhost:3000; in production set this to your
# deployed frontend, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Gmail account + app password used to send email login codes (nodemailer)
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# Finnhub API key for the real-time FX price WebSocket feed
FINNHUB_API_KEY=your-finnhub-api-key

# Signing key for the API's own session tokens (JWTs). Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a-long-random-secret

# Firebase project id, used to verify Google sign-in ID tokens against Google's
# public keys. Not a secret (it is already in the client bundle).
FIREBASE_PROJECT_ID=your-firebase-project-id
